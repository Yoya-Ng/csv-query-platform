# 既有 PostgreSQL server 連線設定（複製為 env/external.env 後填入）。
# Docker Desktop 同一主機上的 DB 通常使用 host.docker.internal；不同主機填 DNS 名稱或 IP。
# URI 使用者名稱／密碼中的特殊字元須 percent-encode（例如 @ -> %40）。
CQP_DSN_RW=postgresql://app_rw:URL_ENCODED_PASSWORD@db.example.internal:5432/cqp?sslmode=require
CQP_DSN_RO=postgresql://app_ro:URL_ENCODED_PASSWORD@db.example.internal:5432/cqp?sslmode=require

CQP_WORKERS=2
CQP_HOST=localhost
CQP_WRITE_ALLOW=private_ranges
