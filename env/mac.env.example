# Mac 測試環境 — 只驗證功能與相對速度（SPEC 3.4）
# Docker Desktop 只有約 7.65GB（docker info 的 Total Memory），不能用 Windows 的 6GB shared_buffers，
# 所以依比例調小：DB 容器上限 5g，shared_buffers 1GB（約 20%），其餘留給 app、proxy 與系統。
# 複製為 env/mac.env 並填入密碼（env/*.env 已被 .gitignore 排除）。
# 密碼只用英數字（會直接組進 DSN URL，不做 URL 編碼）；tools/make_local_env.py 產生 32 字 hex
POSTGRES_PASSWORD=CHANGE_ME
CQP_RW_PASSWORD=CHANGE_ME
CQP_RO_PASSWORD=CHANGE_ME
# 專案自帶 DB 的 app 連線。改用既有 PostgreSQL 時，請改成其 host:port/database。
CQP_DSN_RW=postgresql://app_rw:${CQP_RW_PASSWORD}@db:5432/cqp
CQP_DSN_RO=postgresql://app_ro:${CQP_RO_PASSWORD}@db:5432/cqp

DB_MEM_LIMIT=5g
DB_SHM_SIZE=1g
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_MAX_PARALLEL_WORKERS_PER_GATHER=2
PG_MAX_WAL_SIZE=4GB
PG_MAX_CONNECTIONS=50

CQP_WORKERS=2
CQP_HOST=localhost
CQP_WRITE_ALLOW=private_ranges
