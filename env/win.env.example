# Windows 正式主機（WSL2 配 24GB，容器可用約 20GB）— SPEC 3.3 初始參數
# 複製為 env/win.env 並填入密碼（env/*.env 已被 .gitignore 排除）。密碼請用隨機長字串，避免含空白與引號。
# 密碼只用英數字（會直接組進 DSN URL，不做 URL 編碼）；tools/make_local_env.py 產生 32 字 hex
POSTGRES_PASSWORD=CHANGE_ME
CQP_RW_PASSWORD=CHANGE_ME
CQP_RO_PASSWORD=CHANGE_ME
# 專案自帶 DB 的 app 連線。改用既有 PostgreSQL 時，請改成其 host:port/database。
CQP_DSN_RW=postgresql://app_rw:${CQP_RW_PASSWORD}@db:5432/cqp
CQP_DSN_RO=postgresql://app_ro:${CQP_RO_PASSWORD}@db:5432/cqp

DB_MEM_LIMIT=20g
DB_SHM_SIZE=2g
PG_SHARED_BUFFERS=6GB
PG_EFFECTIVE_CACHE_SIZE=16GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=2GB
PG_MAX_PARALLEL_WORKERS_PER_GATHER=2
PG_MAX_WAL_SIZE=16GB
PG_MAX_CONNECTIONS=50

CQP_WORKERS=2
# 使用者連線的主機名或固定 IP（https://<CQP_HOST>）；Caddy 內部憑證以此命名
CQP_HOST=localhost
# 寫入類路徑允許的來源（空白分隔 CIDR；預設 Caddy 的 private_ranges）
CQP_WRITE_ALLOW=private_ranges
